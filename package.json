  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "checks": "scripts/checks.sh",
    "tokens": "node scripts/tokens.mjs",
    "icons": "node scripts/icons.mjs",
    "tauri": "tauri",
    "snapshot": "cargo run --quiet --manifest-path src-tauri/Cargo.toml -- --snapshot --table"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
