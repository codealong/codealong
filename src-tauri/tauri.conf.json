{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codealong",
  "version": "0.7.0",
  "identifier": "app.codealong.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Codealong",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: codealong-image: https://*.githubusercontent.com https://github.com; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDMjJBRTc5OEMzM0YyNjYKUldSbThqT01lYTRpYkRTSUhBem5kOXlQOHV5NjIwR3E3RElXTGN3MFFWT3lQM0JDZFFMdWdtSEEK",
      "endpoints": [
        "https://www.codealong.com/api/update/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/codealong/codealong/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../skills/codealong": "skills/codealong",
      "../.claude-plugin/marketplace.json": "plugin-marketplace/.claude-plugin/marketplace.json",
      "../plugin/.claude-plugin/plugin.json": "plugin-marketplace/plugin/.claude-plugin/plugin.json",
      "../plugin/bin/codealong": "plugin-marketplace/plugin/bin/codealong",
      "../plugin/hooks/hooks.json": "plugin-marketplace/plugin/hooks/hooks.json",
      "../plugin/skills/orchestrate/SKILL.md": "plugin-marketplace/plugin/skills/orchestrate/SKILL.md",
      "../plugin/skills/visualize/SKILL.md": "plugin-marketplace/plugin/skills/visualize/SKILL.md"
    },
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Gordon L. Hempton",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist"
    }
  }
}
