<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A build signed with a Developer ID runs under the hardened runtime, which lets the app send
       Apple Events only with this. Codealong scripts Ghostty, iTerm2 and Terminal (through
       osascript, its child) to open, focus and type into sessions; macOS still asks the person
       once for each. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- And lets it use the microphone only with this: hold-to-talk and listenings, through
       codealong-ear, which is signed with the same entitlements. macOS still asks the person. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- And read the person's calendar only with this: codealong-ear reads it (EventKit) to offer
       to take notes as a meeting starts. macOS still asks the person. -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
</dict>
</plist>
